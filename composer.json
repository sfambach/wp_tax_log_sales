{
    "name": "sfambach/wp-tax-log-sales",
    "description": "Taxmod Sales — sales, their material and their goods issue on top of the Taxonomy Modeller and Taxmod Stock.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "TaxmodSales\\Core\\": "src/Core/",
            "TaxmodSales\\WordPress\\": "src/WordPress/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload-dev": {
        "psr-4": {
            "TaxmodSales\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
